  "sides": {
    "cms-java": {
      "runner": "python sides/port_runner.py --which cms",
      "repo": "CMS's own Java migration, Hospice Pricer 2.5.1, Implementation-Version 2.5.1.2025-11-13T21:19:01Z (executable JAR from cms.gov/pricersourcecodesoftware, sha256 8463ea46eca855c9c3a2c8eaac2293688f1bc1919c6ce3af3d21b129871c72fe as pinned in fetch.py; a FOIA release with no licence file, fetched at run time into cache/, never committed)",
      "licence": "none stated: a CMS FOIA transparency release, fetched at run time and never committed",
      "line": "CalculateFinalPayments.java:36-43 totalPayment is the sum of the unrounded per-level rates, rounded once at the end (setScale(2, HALF_UP)), while lines 64-77 round each level's own payment; the COBOL adds the rounded per-level rates (HOSPR210.cbl:5857-5862)",
      "source": "cache/cms_java/src",
      "causes": [
        {
          "what": "the claim total is the sum of the unrounded per-level rates rounded once, where the COBOL adds the per-level amounts it has already rounded into WRK-PAY-RATE1-4 (PIC 9(06)V9(02))",
          "port": "gov/cms/fiss/pricers/hospice/core/rules/CalculateFinalPayments.java:36-43",
          "cobol": [
            "cache/cobol/HOSPR210.cbl:5857-5862",
